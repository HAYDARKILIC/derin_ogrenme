    "## 5. K-Hop Komşuluğu ve Algılama Alanı (Ch. 13.7)\n",
    "\n",
    "Her GCN katmanı bir düğümün **1-hop komşuluğundan** bilgi toplar.  \n",
    "K katman sonra her düğüm **K-hop komşuluğunu** görür.\n",
    "\n",
    "Bu CNN'deki **algılama alanı (receptive field)** kavramının Graf karşılığıdır.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f093c6ce",
   "metadata": {},
   "outputs": [],
   "source": [
    "def get_k_hop_neighborhood(G, node, k):\n",
    "    '''Bir dugumun k-hop komsulugunun dugumleri.'''\n",
    "    neighbors = {node}\n",
    "    frontier = {node}\n",
    "    for _ in range(k):\n",
    "        next_frontier = set()\n",
    "        for n in frontier:\n",
    "            next_frontier.update(G.neighbors(n))\n",
    "        next_frontier -= neighbors\n",
    "        neighbors.update(next_frontier)\n",
    "        frontier = next_frontier\n",
    "    return neighbors\n",
    "\n",
    "target_node = 0\n",
    "fig, axes = plt.subplots(1, 3, figsize=(15, 4))\n",
    "\n",
    "for ax, k in zip(axes, [1, 2, 3]):\n",
    "    hop_nodes = get_k_hop_neighborhood(G, target_node, k)\n",
    "    outside = set(G.nodes()) - hop_nodes\n",
    "\n",
    "    colors = []\n",
    "    for n in G.nodes():\n",
    "        if n == target_node:\n",
    "            colors.append('crimson')\n",
    "        elif n in hop_nodes:\n",
    "            colors.append('steelblue')\n",
    "        else:\n",
    "            colors.append('lightgray')\n",
    "\n",
    "    pos_k = nx.spring_layout(G, seed=42)\n",
    "    nx.draw_networkx(G, pos_k, ax=ax, node_color=colors, node_size=600,\n",
    "                     font_color='white', edge_color='gray', width=2)\n",
    "    ax.set_title(f\"{k}-Hop Komşuluğu\\nv{target_node} (kırmızı) için algılama alanı\", fontsize=11)\n",
    "\n",
    "    legend_elems = [mpatches.Patch(color='crimson',   label=f'v{target_node} (hedef)'),\n",
    "                    mpatches.Patch(color='steelblue', label=f'{k}-hop komsular ({len(hop_nodes)-1})'),\n",
    "                    mpatches.Patch(color='lightgray', label='Dışarıda')]\n",
    "    ax.legend(handles=legend_elems, loc='lower right', fontsize=7)\n",
    "    ax.axis('off')\n",
    "\n",
    "plt.suptitle(\"K-Hop Komşuluğu = GCN Algılama Alanı\", fontsize=13)\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"fig_nb11_receptive_field.png\", dpi=100, bbox_inches='tight')\n",
    "plt.show()\n"
   ]
  },
