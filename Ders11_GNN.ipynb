    "## 2. Komşuluk Matrisinin Güçleri (Ch. 13.2)\n",
    "\n",
    "Kitabın önemli bir gözlemi:\n",
    "\n",
    "> $A^L$ matrisinin $(m,n)$ konumundaki değer, $m$'den $n$'ye uzunluğu $L$ olan **yürüyüş (walk) sayısını** verir.\n",
    "\n",
    "Bu, düğümler arasındaki bağlanabilirlik bilgisini kodlar ve GNN katmanlarının neden çok adımlı komşuluğu yakalayabildiğini açıklar.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0ca59bb6",
   "metadata": {},
   "outputs": [],
   "source": [
    "# A^L güçlerini hesapla\n",
    "A_float = A.astype(float)\n",
    "A2 = A_float @ A_float   # 2-adımlık yürüyüşler\n",
    "A3 = A2 @ A_float        # 3-adımlık yürüyüşler\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(14, 4))\n",
    "for ax, (mat, title) in zip(axes, [\n",
    "    (A,         \"A   (1-adım yürüyüş)\"),\n",
    "    (A2.astype(int), \"A²  (2-adım yürüyüş)\"),\n",
    "    (A3.astype(int), \"A³  (3-adım yürüyüş)\"),\n",
    "]):\n",
    "    im = ax.imshow(mat, cmap='YlOrRd', aspect='auto')\n",
    "    for i in range(6):\n",
    "        for j in range(6):\n",
    "            ax.text(j, i, str(int(mat[i,j])), ha='center', va='center', fontsize=11,\n",
    "                    color='white' if mat[i,j] > mat.max()*0.6 else 'black')\n",
    "    ax.set_title(title, fontsize=12)\n",
    "    ax.set_xticks(range(6)); ax.set_yticks(range(6))\n",
    "    ax.set_xticklabels([f\"v{i}\" for i in range(6)])\n",
    "    ax.set_yticklabels([f\"v{i}\" for i in range(6)])\n",
    "    plt.colorbar(im, ax=ax)\n",
    "\n",
    "plt.suptitle(\"Komşuluk Matrisinin Güçleri: L-adımlık Bağlanabilirlik\", fontsize=13)\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"fig_nb11_adj_powers.png\", dpi=100, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "# v0'dan diğer düğümlere erişim\n",
    "print(\"v0'dan başlayarak:\")\n",
    "print(f\"  1 adımda ulaşılan: v{np.where(A[0]>0)[0].tolist()} → {int(A[0].sum())} yürüyüş\")\n",
    "print(f\"  2 adımda ulaşılan: {int(A2[0].sum())} toplam yürüyüş\")\n",
    "print(f\"  3 adımda ulaşılan: {int(A3[0].sum())} toplam yürüyüş\")\n"
   ]
