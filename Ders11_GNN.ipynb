    "def softmax(z, axis=-1):\n",
    "    e = np.exp(z - z.max(axis=axis, keepdims=True))\n",
    "    return e / e.sum(axis=axis, keepdims=True)\n",
    "\n",
    "softmax = lambda z: __import__('numpy').exp(z - z.max(axis=-1,keepdims=True)) / __import__('numpy').exp(z - z.max(axis=-1,keepdims=True)).sum(axis=-1,keepdims=True)\n",
    "\n",
    "# Zachary Karate Club grafu\n",
    "G_kc = nx.karate_club_graph()\n",
    "N_kc = G_kc.number_of_nodes()\n",
    "\n",
    "# Gercek etiketler\n",
    "labels_kc = np.array([1 if G_kc.nodes[n]['club'] == 'Officer' else 0\n",
    "                       for n in G_kc.nodes()])\n",
    "\n",
    "A_kc = nx.to_numpy_array(G_kc)\n",
    "A_kc_norm = kipf_normalize(A_kc)\n",
    "\n",
    "# Baslangiç özellikleri: normalize derece + kucuk rastgele projeksiyon\n",
    "np.random.seed(5)\n",
    "degrees_kc = A_kc.sum(axis=1, keepdims=True)\n",
    "X_proj     = np.random.randn(N_kc, 8) * 0.5   # rastgele baslangic ozellikleri\n",
    "X_kc = np.concatenate([degrees_kc / degrees_kc.max(), X_proj], axis=1)\n",
    "D_in_kc = X_kc.shape[1]   # 9\n",
    "\n",
    "# 2 katmanli GCN - PyTorch olmadan elle SGD\n",
    "np.random.seed(3)\n",
    "D_h = 8\n",
    "W1_kc = np.random.randn(D_in_kc, D_h) * 0.1\n",
    "W2_kc = np.random.randn(D_h, 2) * 0.1\n",
    "\n",
    "def softmax_2d(z):\n",
    "    e = np.exp(z - z.max(axis=1, keepdims=True))\n",
    "    return e / e.sum(axis=1, keepdims=True)\n",
    "\n",
    "def gcn_forward(X, A_n, W1, W2):\n",
    "    H1 = relu(A_n @ X @ W1)\n",
    "    H2 = A_n @ H1 @ W2\n",
    "    return softmax_2d(H2), H1\n",
    "\n",
    "def ce_loss(probs, y_idx):\n",
    "    return -np.mean(np.log(probs[np.arange(len(y_idx)), y_idx] + 1e-9))\n",
    "\n",
    "# Egitim maskesi: her siniftan 5 dugum\n",
    "train_mask = np.zeros(N_kc, dtype=bool)\n",
    "for cls in [0, 1]:\n",
    "    idxs = np.where(labels_kc == cls)[0][:5]\n",
    "    train_mask[idxs] = True\n",
    "\n",
    "lr = 0.1\n",
    "losses, accs_tr, accs_te = [], [], []\n",
    "\n",
    "for epoch in range(200):\n",
    "    probs, H1 = gcn_forward(X_kc, A_kc_norm, W1_kc, W2_kc)\n",
    "    loss = ce_loss(probs[train_mask], labels_kc[train_mask])\n",
    "    losses.append(loss)\n",
    "\n",
    "    # Analitik gradyan (softmax + cross-entropy)\n",
    "    N_tr  = train_mask.sum()\n",
    "    delta = probs.copy()\n",
    "    delta[train_mask, labels_kc[train_mask]] -= 1\n",
    "    delta[~train_mask] = 0\n",
    "    delta /= N_tr\n",
    "\n",
    "    # Katman 2 gradyani: H2 = A @ H1 @ W2\n",
    "    # dL/dW2 = (A @ H1)^T @ delta\n",
    "    AH1 = A_kc_norm @ H1\n",
    "    dW2 = AH1.T @ delta\n",
    "\n",
    "    # Geri yay: H1 katmanina\n",
    "    dAH1 = delta @ W2_kc.T                          # (N, D_h)\n",
    "    dH1  = A_kc_norm.T @ dAH1                       # (N, D_h)\n",
    "    dZ1  = dH1 * (H1 > 0)                           # ReLU turev\n",
    "    dW1  = (A_kc_norm @ X_kc).T @ dZ1\n",
    "\n",
    "    W1_kc -= lr * dW1\n",
    "    W2_kc -= lr * dW2\n",
    "\n",
    "    preds = probs.argmax(axis=1)\n",
    "    accs_tr.append((preds[train_mask]  == labels_kc[train_mask]).mean())\n",
    "    accs_te.append((preds[~train_mask] == labels_kc[~train_mask]).mean())\n",
    "\n",
    "print(f\"Son egitim dogruluğu: {accs_tr[-1]:.3f}\")\n",
    "print(f\"Son test dogruluğu:   {accs_te[-1]:.3f}\")\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(13, 4))\n",
    "axes[0].plot(losses,  color='steelblue', lw=2, label=\"Egitim kaybi (CE)\")\n",
    "axes[0].plot(accs_tr, color='crimson',    lw=2, label=\"Egitim dogruluğu\")\n",
    "axes[0].plot(accs_te, color='darkorange', lw=2, label=\"Test dogruluğu\")\n",
    "axes[0].set_title(\"2-Katmanli GCN: Karate Club Dugum Siniflandirmasi\", fontsize=12)\n",
    "axes[0].set_xlabel(\"Epoch\"); axes[0].legend(); axes[0].grid(alpha=0.3)\n",
    "\n",
    "probs_final, _ = gcn_forward(X_kc, A_kc_norm, W1_kc, W2_kc)\n",
    "preds_final = probs_final.argmax(axis=1)\n",
    "\n",
    "pos_kc = nx.spring_layout(G_kc, seed=0)\n",
    "node_cols = []\n",
    "for n in G_kc.nodes():\n",
    "    pred = preds_final[n]; true = labels_kc[n]\n",
    "    if pred == true:\n",
    "        node_cols.append('steelblue' if true == 0 else 'crimson')\n",
    "    else:\n",
    "        node_cols.append('gold')\n",
    "\n",
    "nx.draw_networkx(G_kc, pos_kc, ax=axes[1], node_color=node_cols,\n",
    "                 node_size=220, font_size=7, font_color='white',\n",
    "                 edge_color='lightgray', width=0.8, with_labels=True)\n",
    "train_nodes = list(np.where(train_mask)[0])\n",
    "nx.draw_networkx_nodes(G_kc, pos_kc, nodelist=train_nodes, ax=axes[1],\n",
    "                       node_color=[node_cols[n] for n in train_nodes],\n",
    "                       node_size=350, linewidths=2,\n",
    "                       edgecolors='black')\n",
    "\n",
    "legend_elems = [mpatches.Patch(color='steelblue', label='Sinif 0 (dogru)'),\n",
    "                mpatches.Patch(color='crimson',   label='Sinif 1 (dogru)'),\n",
    "                mpatches.Patch(color='gold',      label='Yanlis sinif.')]\n",
    "axes[1].legend(handles=legend_elems, loc='lower left', fontsize=7)\n",
    "axes[1].set_title(f\"GCN Tahminleri (test acc={accs_te[-1]:.2f})\", fontsize=12)\n",
    "axes[1].axis('off')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"fig_nb11_node_clf.png\", dpi=100, bbox_inches='tight')\n",
    "plt.show()\n"
   ]
