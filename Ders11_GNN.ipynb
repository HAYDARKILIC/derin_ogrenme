    "## 9. Gerçekçi Örnek: Molekül Sınıflandırması (Ch. 13.5)\n",
    "\n",
    "GNN'lerin en başarılı uygulama alanlarından biri **moleküler kimya**:\n",
    "- Atom = Düğüm, Kimyasal bağ = Kenar\n",
    "- Hedef: Molekülün toksik mi değil mi olduğunu tahmin et\n",
    "\n",
    "Aşağıda birkaç basit molekülü GNN ile temsil edip sınıflandırıyoruz.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "08e95471",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Basit moleküller: Etanol (C2H5OH) ve Asetik Asit (CH3COOH) benzeri yapılar\n",
    "# Sadece atom tipi ve bağ tipi özelliklerini kullanacağız\n",
    "\n",
    "# Atom kodlaması: C=0, O=1, N=2, H=3 (one-hot)\n",
    "def atom_onehot(atom_type, n_types=4):\n",
    "    v = np.zeros(n_types)\n",
    "    v[atom_type] = 1.0\n",
    "    return v\n",
    "\n",
    "# Molekül 1: Etanol-benzeri (C-C-O, 3 atom)\n",
    "def make_molecule_graph(atom_types, bond_list):\n",
    "    n = len(atom_types)\n",
    "    A = np.zeros((n, n))\n",
    "    for i, j in bond_list:\n",
    "        A[i,j] = A[j,i] = 1\n",
    "    X = np.array([atom_onehot(t) for t in atom_types])\n",
    "    return A, X\n",
    "\n",
    "molecules = [\n",
    "    # (atom_types, bonds, label, name)\n",
    "    ([0, 0, 1], [(0,1),(1,2)],       0, \"Etanol benzeri\\n(C-C-O)\"),\n",
    "    ([0, 1, 1], [(0,1),(0,2)],       0, \"Dimetil eter\\n(O-C-O)\"),\n",
    "    ([0, 0, 0, 1], [(0,1),(1,2),(2,3),(0,3)], 1, \"Siklik mol.\\n(halka)\"),\n",
    "    ([0, 2, 0, 1], [(0,1),(1,2),(2,3),(0,3)], 1, \"N-iceren halka\"),\n",
    "    ([0, 0, 1, 1], [(0,1),(1,2),(1,3)],       0, \"Dallı zincir\"),\n",
    "    ([0, 0, 0, 2], [(0,1),(1,2),(2,3),(0,2)], 1, \"Kapalı N-halka\"),\n",
    "]\n",
    "\n",
    "np.random.seed(8)\n",
    "D_mol = 4    # one-hot atom\n",
    "D_h1  = 8\n",
    "D_h2  = 4\n",
    "W_m1 = np.random.randn(D_mol, D_h1) * 0.3\n",
    "W_m2 = np.random.randn(D_h1, D_h2) * 0.3\n",
    "W_clf = np.random.randn(D_h2, 2) * 0.3\n",
    "\n",
    "def molecule_forward(A_m, X_m, W1, W2, Wc):\n",
    "    A_n = kipf_normalize(A_m)\n",
    "    H1 = relu(A_n @ X_m @ W1)\n",
    "    H2 = relu(A_n @ H1 @ W2)\n",
    "    # Graf seviyesi: düğümlerin ortalamasını al (global mean pooling)\n",
    "    g = H2.mean(axis=0, keepdims=True)    # (1, D_h2)\n",
    "    logits = g @ Wc                        # (1, 2)\n",
    "    return softmax(logits)[0], H2\n",
    "\n",
    "fig, axes = plt.subplots(2, 3, figsize=(15, 8))\n",
    "\n",
    "for ax, (atom_types, bonds, label, name) in zip(axes.flat, molecules):\n",
    "    A_m, X_m = make_molecule_graph(atom_types, bonds)\n",
    "    probs_mol, H2_mol = molecule_forward(A_m, X_m, W_m1, W_m2, W_clf)\n",
    "    pred_label = probs_mol.argmax()\n",
    "\n",
    "    G_mol = nx.from_numpy_array(A_m)\n",
    "    pos_mol = nx.spring_layout(G_mol, seed=42)\n",
    "    atom_names = {0:'C', 1:'O', 2:'N', 3:'H'}\n",
    "    atom_colors = {0:'gray', 1:'crimson', 2:'steelblue', 3:'white'}\n",
    "    node_colors_mol = [atom_colors[t] for t in atom_types]\n",
    "    labels_mol = {i: atom_names[t] for i, t in enumerate(atom_types)}\n",
    "\n",
    "    nx.draw_networkx(G_mol, pos_mol, ax=ax,\n",
    "                     node_color=node_colors_mol, node_size=700,\n",
    "                     labels=labels_mol, font_color='white', font_weight='bold',\n",
    "                     edge_color='dimgray', width=3)\n",
    "    correct = \"✓\" if pred_label == label else \"✗\"\n",
    "    ax.set_title(f\"{name}\\nGerçek: {'Toksik' if label else 'Normal'} | \"\n",
    "                 f\"Tahmin: {'Toksik' if pred_label else 'Normal'} {correct}\",\n",
    "                 fontsize=9)\n",
    "    ax.axis('off')\n",
    "\n",
    "plt.suptitle(\"GNN ile Molekul Siniflandirmasi (Rastgele agirliklar)\", fontsize=13)\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"fig_nb11_molecules.png\", dpi=100, bbox_inches='tight')\n",
    "plt.show()\n"
   ]
