    "## 4. Graf Evrişim Katmanı - Mesaj İletimi (Ch. 13.4)\n",
    "\n",
    "Kitaptaki temel GCN katman güncelleme kuralı:\n",
    "\n",
    "$$H_{k+1} = a\\!\\left[\\beta_k \\mathbf{1}^T + \\Omega_k H_k (A + I)\\right]$$\n",
    "\n",
    "- $H_k$: $k$-inci katmandaki düğüm gömme matrisi (D×N)\n",
    "- $A + I$: Komşuluk + öz-döngü (self-loop)\n",
    "- $\\Omega_k$: Öğrenilen ağırlık matrisi\n",
    "- $\\beta_k$: Bias\n",
    "- $a[\\cdot]$: ReLU aktivasyonu\n",
    "\n",
    "**Sezgi:** Her düğüm, komşularının temsillerini toplar ve doğrusal dönüşüm uygular.  \n",
    "Bu, \"mesaj iletimi (message passing)\" olarak adlandırılır.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "40e4b6d3",
   "metadata": {},
   "outputs": [],
   "source": [
    "def relu(x):\n",
    "    return np.maximum(0, x)\n",
    "\n",
    "def gcn_layer(H, A, W, b):\n",
    "    '''\n",
    "    Basit GCN katmani.\n",
    "    H: (N, D_in)  - dugun gommeleri\n",
    "    A: (N, N)     - komsuluk matrisi\n",
    "    W: (D_in, D_out)\n",
    "    b: (D_out,)\n",
    "    Dondurulen: (N, D_out)\n",
    "    '''\n",
    "    A_hat = A + np.eye(len(A))      # ozdongulu ekle\n",
    "    return relu(A_hat @ H @ W + b)  # (N, D_out)\n",
    "\n",
    "# Küçük örnekte mesaj iletimini adım adım izle\n",
    "N = 6\n",
    "D_in, D_hidden = 3, 4\n",
    "np.random.seed(1)\n",
    "W1 = np.random.randn(D_in, D_hidden) * 0.3\n",
    "b1 = np.zeros(D_hidden)\n",
    "\n",
    "H0 = X.copy()   # Başlangıç: ham düğüm özellikleri\n",
    "H1 = gcn_layer(H0, A, W1, b1)   # 1. katman sonrası\n",
    "\n",
    "print(f\"H0 (giriş) sekli:        {H0.shape}\")\n",
    "print(f\"H1 (1. katman) sekli:    {H1.shape}\")\n",
    "print()\n",
    "print(\"v1 için mesaj iletimi adımları:\")\n",
    "print(f\"  v1'in komşuları: {list(G.neighbors(1))}\")\n",
    "print(f\"  H0[v1]          = {H0[1].round(2)}\")\n",
    "agg_v1 = H0[[1] + list(G.neighbors(1))].sum(axis=0)\n",
    "print(f\"  Toplam (v1+komsular) = {agg_v1.round(2)}\")\n",
    "print(f\"  H1[v1] = ReLU(aggr @ W + b) = {H1[1].round(3)}\")\n",
    "\n",
    "# 2 katmanlı GCN - farklı başlangıç gömmeleriyle\n",
    "W2 = np.random.randn(D_hidden, 2) * 0.3\n",
    "b2 = np.zeros(2)\n",
    "H2 = gcn_layer(H1, A, W2, b2)\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(14, 4))\n",
    "for ax, (H, title) in zip(axes, [\n",
    "    (H0, \"H0: Ham özellikler (D=3)\"),\n",
    "    (H1, \"H1: 1. GCN katmanı (D=4)\"),\n",
    "    (H2, \"H2: 2. GCN katmanı (D=2)\"),\n",
    "]):\n",
    "    im = ax.imshow(H, cmap='RdBu_r', aspect='auto')\n",
    "    ax.set_title(title, fontsize=11)\n",
    "    ax.set_yticks(range(N))\n",
    "    ax.set_yticklabels([f\"v{i}\" for i in range(N)])\n",
    "    ax.set_xlabel(\"Gömme boyutu\")\n",
    "    plt.colorbar(im, ax=ax)\n",
    "\n",
    "plt.suptitle(\"GCN Katmanları: Mesaj İletimi Sonrası Düğüm Gömmeleri\", fontsize=13)\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"fig_nb11_gcn_layers.png\", dpi=100, bbox_inches='tight')\n",
    "plt.show()\n"
   ]
  },
