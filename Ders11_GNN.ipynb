    "## 8. Graf Dikkat Ağı (Graph Attention Network - GAT) (Ch. 13.8.5)\n",
    "\n",
    "GCN'de komşuluk ağırlıkları **sabit** (derece tabanlı).  \n",
    "GAT'ta ağırlıklar **veriye bağlı** (öğrenilmiş dikkat):\n",
    "\n",
    "$$s_{mn} = a\\!\\left[\\phi^T \\begin{pmatrix} h_m' \\\\ h_n' \\end{pmatrix}\\right]$$\n",
    "\n",
    "$$H_{k+1} = a\\!\\left[H_k' \\cdot \\text{Softmask}(S, A+I)\\right]$$\n",
    "\n",
    "Transformer'daki self-attention + graf yapısının birleşimi olarak düşünülebilir.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1c667303",
   "metadata": {},
   "outputs": [],
   "source": [
    "def gat_layer(H, A, W, a_vec, activation=relu):\n",
    "    '''\n",
    "    Basitleştirilmiş GAT katmanı.\n",
    "    H: (N, D_in)\n",
    "    A: (N, N) komsuluk\n",
    "    W: (D_in, D_out) dogrusal donusum\n",
    "    a_vec: (2*D_out,) dikkat vektoru\n",
    "    '''\n",
    "    N, D_in = H.shape\n",
    "    D_out = W.shape[1]\n",
    "    H_prime = H @ W                     # (N, D_out)\n",
    "\n",
    "    # Dikkat skorları\n",
    "    S = np.zeros((N, N))\n",
    "    for i in range(N):\n",
    "        for j in range(N):\n",
    "            if A[i,j] > 0 or i == j:   # sadece komşular + öz\n",
    "                concat = np.concatenate([H_prime[i], H_prime[j]])\n",
    "                S[i,j] = np.dot(a_vec, concat)\n",
    "\n",
    "    # Softmax (sadece komşular + öz için)\n",
    "    mask = (A + np.eye(N)) > 0\n",
    "    S_masked = np.where(mask, S, -1e9)\n",
    "    exp_S = np.exp(S_masked - S_masked.max(axis=1, keepdims=True))\n",
    "    attn_weights = exp_S / (exp_S.sum(axis=1, keepdims=True) + 1e-9)\n",
    "    attn_weights = attn_weights * mask   # sadece komşular\n",
    "\n",
    "    H_out = activation(attn_weights @ H_prime)\n",
    "    return H_out, attn_weights\n",
    "\n",
    "# Küçük grafta GAT dikkat ağırlıklarını görselleştir\n",
    "np.random.seed(5)\n",
    "D_out_gat = 4\n",
    "W_gat = np.random.randn(D_in, D_out_gat) * 0.3\n",
    "a_gat  = np.random.randn(2 * D_out_gat) * 0.3\n",
    "\n",
    "H_gat, attn = gat_layer(X, A, W_gat, a_gat)\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(13, 5))\n",
    "\n",
    "# Dikkat ağırlıkları ısı haritası\n",
    "im = axes[0].imshow(attn, cmap='Blues', vmin=0, vmax=attn.max())\n",
    "axes[0].set_title(\"GAT Dikkat Ağırlıkları\\n(Satır = sorgu düğümü, Sütun = anahtar düğümü)\", fontsize=11)\n",
    "axes[0].set_xticks(range(6)); axes[0].set_yticks(range(6))\n",
    "axes[0].set_xticklabels([f\"v{i}\" for i in range(6)])\n",
    "axes[0].set_yticklabels([f\"v{i}\" for i in range(6)])\n",
    "for i in range(6):\n",
    "    for j in range(6):\n",
    "        axes[0].text(j, i, f\"{attn[i,j]:.2f}\", ha='center', va='center', fontsize=9,\n",
    "                     color='white' if attn[i,j] > 0.3 else 'black')\n",
    "plt.colorbar(im, ax=axes[0])\n",
    "\n",
    "# Graf üzerinde dikkat ağırlıklarını kenar kalınlığı olarak göster\n",
    "ax = axes[1]\n",
    "pos_vis2 = nx.spring_layout(G, seed=42)\n",
    "nx.draw_networkx_nodes(G, pos_vis2, ax=ax, node_color='steelblue',\n",
    "                       node_size=500)\n",
    "nx.draw_networkx_labels(G, pos_vis2, ax=ax, font_color='white', font_weight='bold')\n",
    "\n",
    "# Kenarları dikkat ağırlığına göre çiz\n",
    "for u, v in G.edges():\n",
    "    w = (attn[u,v] + attn[v,u]) / 2\n",
    "    nx.draw_networkx_edges(G, pos_vis2, edgelist=[(u,v)], ax=ax,\n",
    "                           width=w*12, alpha=0.6, edge_color='darkorange')\n",
    "\n",
    "ax.set_title(\"Graf Üzerinde Dikkat Ağırlıkları\\n(Kenar kalınlığı = dikkat)\", fontsize=11)\n",
    "ax.axis('off')\n",
    "\n",
    "plt.suptitle(\"Graf Dikkat Ağı (GAT): GCN vs Öğrenilmiş Dikkat\", fontsize=13)\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"fig_nb11_gat.png\", dpi=100, bbox_inches='tight')\n",
    "plt.show()\n"
   ]
