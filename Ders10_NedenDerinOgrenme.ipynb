   "source": [
    "# Ders 10: Neden Derin Öğrenme Çalışıyor?\n",
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "44ab9476",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.datasets import make_moons, make_classification, load_digits\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "\n",
    "np.random.seed(42)\n",
    "print(\"Kutuphaneler hazir.\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0be53e52",
   "metadata": {},
   "source": [
    "## 1. Kayıp Yüzeyinin Özellikleri (Ch. 20.3)\n",
    "\n",
    "Derin öğrenmede kayıp yüzeyi:\n",
    "- Çok sayıda **yerel minimum** var, ama çoğu birbirine yakın değerde\n",
    "- **Saddle points** (eğer noktaları) yerel minimumlara kıyasla daha fazla\n",
    "- **Düz bölgeler (flat minima)** → daha iyi genelleme\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f5318551",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2D kayip yuzeyi: duzlugun genellemeye etkisi\n",
    "def sharp_minimum(w1, w2):\n",
    "    return 5*(w1-1)**2 + 50*(w2-0.5)**2\n",
    "\n",
    "def flat_minimum(w1, w2):\n",
    "    return 0.5*(w1-(-1))**2 + 0.8*(w2-(-0.5))**2\n",
    "\n",
    "w1 = np.linspace(-3, 4, 200)\n",
    "w2 = np.linspace(-2, 2.5, 200)\n",
    "W1, W2 = np.meshgrid(w1, w2)\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(13, 4))\n",
    "\n",
    "for ax, (name, fn, cx, cy) in zip(axes, [\n",
    "    (\"Keskin Minimum\", sharp_minimum, 1.0, 0.5),\n",
    "    (\"Duz Minimum\",   flat_minimum,  -1.0, -0.5),\n",
    "]):\n",
    "    Z = np.log(fn(W1, W2) + 1)\n",
    "    ax.contourf(W1, W2, Z, levels=25, cmap='YlOrRd', alpha=0.85)\n",
    "    ax.contour(W1, W2, Z, levels=25, colors='white', linewidths=0.4, alpha=0.4)\n",
    "    ax.plot(cx, cy, 'b*', markersize=15, label=\"Bulunan minimum\")\n",
    "    \n",
    "    # Perturbation bolgesi\n",
    "    circle = plt.Circle((cx, cy), 0.5, fill=False, color='blue', lw=2, linestyle='--')\n",
    "    ax.add_patch(circle)\n",
    "    ax.set_title(f\"{name}\\n(Kucuk perturbasyona karsı {'hassas' if 'Keskin' in name else 'dayanikli'})\")\n",
    "    ax.legend(); ax.grid(alpha=0.2)\n",
    "    ax.set_xlabel(\"w1\"); ax.set_ylabel(\"w2\")\n",
    "\n",
    "plt.suptitle(\"Duz vs Keskin Minimum: Genelleme Etkisi\", fontsize=13)\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"fig_nb10_landscape.png\", dpi=100, bbox_inches='tight')\n",
    "plt.show()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7938b80a",
   "metadata": {},
   "source": [
    "## 2. Overparametrization ve Genelleme (Ch. 20.4)\n",
    "\n",
    "Klasik istatistikte fazla parametre = overfitting.  \n",
    "Ancak derin öğrenmede **çok büyük ağlar** bazen küçüklere göre **daha iyi geneller**.\n",
    "\n",
    "Bu \"implicit regularization\" olarak adlandırılır: SGD büyük ağlarda düz minimumlara yönelir.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d17008b0",
   "metadata": {},
   "outputs": [],
   "source": [
    "try:\n",
    "    import torch\n",
    "    import torch.nn as nn\n",
    "    import torch.optim as optim\n",
    "    TORCH = True\n",
    "except ImportError:\n",
    "    TORCH = False\n",
    "    print(\"PyTorch yok; simule edilmis sonuclar gosterilecek.\")\n",
    "\n",
    "if TORCH:\n",
    "    # make_moons veri seti\n",
    "    X_m, y_m = make_moons(n_samples=200, noise=0.2, random_state=42)\n",
    "    scaler = StandardScaler()\n",
    "    X_m = scaler.fit_transform(X_m)\n",
    "    X_tr, X_te, y_tr, y_te = train_test_split(X_m, y_m, test_size=0.3, random_state=42)\n",
    "    \n",
    "    Xtr_t = torch.FloatTensor(X_tr)\n",
    "    ytr_t = torch.LongTensor(y_tr)\n",
    "    Xte_t = torch.FloatTensor(X_te)\n",
    "    yte_t = torch.LongTensor(y_te)\n",
    "    \n",
    "    def make_net(hidden_size):\n",
    "        return nn.Sequential(\n",
    "            nn.Linear(2, hidden_size), nn.ReLU(),\n",
    "            nn.Linear(hidden_size, hidden_size), nn.ReLU(),\n",
    "            nn.Linear(hidden_size, 2)\n",
    "        )\n",
    "    \n",
    "    def train_net(net, epochs=500, lr=0.01):\n",
    "        opt = optim.Adam(net.parameters(), lr=lr)\n",
    "        criterion = nn.CrossEntropyLoss()\n",
    "        tr_acc_log, te_acc_log = [], []\n",
    "        for ep in range(epochs):\n",
    "            net.train()\n",
    "            opt.zero_grad()\n",
    "            out = net(Xtr_t)\n",
    "            loss = criterion(out, ytr_t)\n",
    "            loss.backward(); opt.step()\n",
    "            if ep % 10 == 0:\n",
    "                net.eval()\n",
    "                with torch.no_grad():\n",
    "                    tr_acc = (net(Xtr_t).argmax(1) == ytr_t).float().mean().item()\n",
    "                    te_acc = (net(Xte_t).argmax(1) == yte_t).float().mean().item()\n",
    "                    tr_acc_log.append(tr_acc); te_acc_log.append(te_acc)\n",
    "        return tr_acc_log, te_acc_log\n",
    "    \n",
    "    sizes = [4, 16, 64, 256]\n",
    "    results = {}\n",
    "    for sz in sizes:\n",
    "        net = make_net(sz)\n",
    "        n_params = sum(p.numel() for p in net.parameters())\n",
    "        tr, te = train_net(net, epochs=600)\n",
    "        results[sz] = {'tr': tr, 'te': te, 'params': n_params}\n",
    "        print(f\"Hidden={sz:4d} | params={n_params:6d} | son_test_acc={te[-1]:.3f}\")\n",
    "    \n",
    "    fig, axes = plt.subplots(1, 2, figsize=(13, 4))\n",
    "    colors_list = ['steelblue', 'darkorange', 'crimson', 'purple']\n",
    "    for sz, color in zip(sizes, colors_list):\n",
    "        ep_range = np.arange(len(results[sz]['tr'])) * 10\n",
    "        axes[0].plot(ep_range, results[sz]['tr'], color=color, lw=1.5, alpha=0.5)\n",
    "        axes[0].plot(ep_range, results[sz]['te'], color=color, lw=2, \n",
    "                    label=f\"h={sz} ({results[sz]['params']} param)\")\n",
    "    axes[0].set_title(\"Egitim (ince) vs Test (kalin) Doğruluğu\")\n",
    "    axes[0].set_xlabel(\"Epoch\"); axes[0].set_ylabel(\"Dogruluk\")\n",
    "    axes[0].legend(fontsize=8); axes[0].grid(alpha=0.3)\n",
    "    \n",
    "    param_counts = [results[sz]['params'] for sz in sizes]\n",
    "    test_accs = [results[sz]['te'][-1] for sz in sizes]\n",
    "    axes[1].plot(param_counts, test_accs, '-o', color='steelblue', lw=2, markersize=8)\n",
    "    for sz, pc, ta in zip(sizes, param_counts, test_accs):\n",
    "        axes[1].annotate(f\"h={sz}\", (pc, ta), textcoords=\"offset points\", xytext=(5,5))\n",
    "    axes[1].set_title(\"Parametre Sayisi vs Test Dogruluğu\")\n",
    "    axes[1].set_xlabel(\"Parametre sayisi\"); axes[1].set_ylabel(\"Test dogrulugu\")\n",
    "    axes[1].grid(alpha=0.3)\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.savefig(\"fig_nb10_overparameterization.png\", dpi=100, bbox_inches='tight')\n",
    "    plt.show()\n",
    "\n",
    "else:\n",
    "    # Simule sonuclar\n",
    "    print(\"Simule edilen sonuclar:\")\n",
    "    sizes_sim = [4, 16, 64, 256]\n",
    "    test_accs_sim = [0.78, 0.88, 0.91, 0.90]\n",
    "    for s, a in zip(sizes_sim, test_accs_sim): print(f\"  h={s}: test_acc={a}\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0adcf9fe",
   "metadata": {},
   "source": [
    "## 3. Derinlik Gerçekten Gerekli mi? (Ch. 20.6)\n",
    "\n",
    "Aynı parametre sayısı için: derin ağ mı daha iyi, sığ ağ mı?  \n",
    "Deneyler tutarlı olarak derin ağların avantajını gösterir.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "17428844",
   "metadata": {},
   "outputs": [],
   "source": [
    "if TORCH:\n",
    "    X_d, y_d = make_classification(n_samples=500, n_features=10, n_informative=8,\n",
    "                                    n_redundant=2, random_state=42)\n",
    "    scaler2 = StandardScaler()\n",
    "    X_d = scaler2.fit_transform(X_d)\n",
    "    X_dtr, X_dte, y_dtr, y_dte = train_test_split(X_d, y_d, test_size=0.3)\n",
    "    Xdtr = torch.FloatTensor(X_dtr); ydtr = torch.LongTensor(y_dtr)\n",
    "    Xdte = torch.FloatTensor(X_dte); ydte = torch.LongTensor(y_dte)\n",
    "    \n",
    "    # ~800 parametre civarinda tutmaya calis\n",
    "    architectures = {\n",
    "        \"Sigh [10,64,2]\":           nn.Sequential(nn.Linear(10,64),nn.ReLU(),nn.Linear(64,2)),\n",
    "        \"Orta [10,20,20,2]\":        nn.Sequential(nn.Linear(10,20),nn.ReLU(),nn.Linear(20,20),nn.ReLU(),nn.Linear(20,2)),\n",
    "        \"Derin [10,12,12,12,12,2]\": nn.Sequential(nn.Linear(10,12),nn.ReLU(),\n",
    "                                                   nn.Linear(12,12),nn.ReLU(),\n",
    "                                                   nn.Linear(12,12),nn.ReLU(),\n",
    "                                                   nn.Linear(12,12),nn.ReLU(),\n",
    "                                                   nn.Linear(12,2)),\n",
    "    }\n",
    "    \n",
    "    print(f\"{'Mimari':<30} {'Parametreler':>12} {'Test Acc':>10}\")\n",
    "    print(\"-\"*55)\n",
    "    arch_results = {}\n",
    "    for name, net in architectures.items():\n",
    "        n_p = sum(p.numel() for p in net.parameters())\n",
    "        opt_d = optim.Adam(net.parameters(), lr=0.005)\n",
    "        criterion = nn.CrossEntropyLoss()\n",
    "        for _ in range(800):\n",
    "            net.train(); opt_d.zero_grad()\n",
    "            loss = criterion(net(Xdtr), ydtr)\n",
    "            loss.backward(); opt_d.step()\n",
    "        net.eval()\n",
    "        with torch.no_grad():\n",
    "            acc = (net(Xdte).argmax(1) == ydte).float().mean().item()\n",
    "        print(f\"{name:<30} {n_p:>12,} {acc:>10.3f}\")\n",
    "        arch_results[name] = acc\n",
    "    \n",
    "    fig, ax = plt.subplots(figsize=(8, 4))\n",
    "    names = list(arch_results.keys())\n",
    "    accs  = list(arch_results.values())\n",
    "    colors_arch = ['steelblue', 'darkorange', 'crimson']\n",
    "    bars = ax.bar(names, accs, color=colors_arch, edgecolor='white', width=0.5)\n",
    "    for bar, acc in zip(bars, accs):\n",
    "        ax.text(bar.get_x()+bar.get_width()/2, acc+0.005, f\"{acc:.3f}\", ha='center', fontsize=11)\n",
    "    ax.set_ylim(0.7, 1.0); ax.set_ylabel(\"Test Dogruluğu\")\n",
    "    ax.set_title(\"Benzer Parametre Sayisiyla: Derinlik Etkisi\")\n",
    "    ax.grid(axis='y', alpha=0.3)\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(\"fig_nb10_depth.png\", dpi=100, bbox_inches='tight')\n",
    "    plt.show()\n",
    "\n",
    "else:\n",
    "    import matplotlib.pyplot as plt\n",
    "    import numpy as np\n",
    "    print(\"PyTorch yok — simule edilmis sonuclar:\")\n",
    "    names = [\"Sigh [10,64,2]\", \"Orta [10,20,20,2]\", \"Derin [10,12,12,12,12,2]\"]\n",
    "    accs  = [0.85, 0.88, 0.91]\n",
    "    params= [834, 682, 796]\n",
    "    print(f\"{'Mimari':<30} {'Parametreler':>12} {'Test Acc':>10}\")\n",
    "    print(\"-\"*55)\n",
    "    for n, p, a in zip(names, params, accs):\n",
    "        print(f\"{n:<30} {p:>12,} {a:>10.3f}\")\n",
    "    fig, ax = plt.subplots(figsize=(8, 4))\n",
    "    colors_arch = ['steelblue', 'darkorange', 'crimson']\n",
    "    bars = ax.bar(names, accs, color=colors_arch, edgecolor='white', width=0.5)\n",
    "    for bar, acc in zip(bars, accs):\n",
    "        ax.text(bar.get_x()+bar.get_width()/2, acc+0.005, f\"{acc:.3f}\", ha='center', fontsize=11)\n",
    "    ax.set_ylim(0.7, 1.0); ax.set_ylabel(\"Test Dogruluğu (simule)\")\n",
    "    ax.set_title(\"Benzer Parametre Sayisiyla: Derinlik Etkisi (Simule)\")\n",
    "    ax.grid(axis='y', alpha=0.3)\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(\"fig_nb10_depth_sim.png\", dpi=100, bbox_inches='tight')\n",
    "    plt.show()\n"
   ]
  },
