    "## 2. Mode Collapse ve GAN Zorlukları (Ch. 15.2)\n",
    "\n",
    "GAN eğitimi kararsız olabilir:\n",
    "- **Mode collapse**: Üretici sadece bir modu öğrenir (çeşitlilik yok)\n",
    "- **Vanishing gradients**: Ayrımcı çok iyi olursa üretici gradyanı sıfıra yaklaşır\n",
    "\n",
    "**Çözümler**: Wasserstein GAN, gradient penalty, feature matching\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "60ea6357",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Mode collapse simülasyonu - çok modlu dağılım\n",
    "np.random.seed(5)\n",
    "# Gerçek veri: 3 modlu Gaussian karışımı\n",
    "def sample_real_multimodal(n):\n",
    "    modes = [(-3, 0.5), (0, 0.3), (3, 0.5)]\n",
    "    choices = np.random.choice(len(modes), n)\n",
    "    samples = np.array([np.random.normal(modes[c][0], modes[c][1]) for c in choices])\n",
    "    return samples\n",
    "\n",
    "x_real_mm = sample_real_multimodal(2000)\n",
    "\n",
    "# Mode collapse: sadece mode 0'ı öğrenen üretici\n",
    "x_mode_collapse = np.random.normal(-3, 0.4, 2000)\n",
    "# İyi üretici: 3 modu da öğreniyor\n",
    "x_good_gen = sample_real_multimodal(2000) + np.random.randn(2000) * 0.1\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(15, 4))\n",
    "bins = np.linspace(-6, 6, 50)\n",
    "\n",
    "axes[0].hist(x_real_mm, bins=bins, density=True, color='steelblue', alpha=0.8, edgecolor='white')\n",
    "axes[0].set_title(\"Gercek Veri: 3 Modlu Dagilim\"); axes[0].grid(alpha=0.3)\n",
    "\n",
    "axes[1].hist(x_mode_collapse, bins=bins, density=True, color='crimson', alpha=0.8, edgecolor='white')\n",
    "axes[1].set_title(\"Mode Collapse: GAN sadece 1 mod ogrenidi\"); axes[1].grid(alpha=0.3)\n",
    "\n",
    "axes[2].hist(x_good_gen, bins=bins, density=True, color='limegreen', alpha=0.8, edgecolor='white')\n",
    "axes[2].set_title(\"Iyi GAN: 3 modu ogrenidi\"); axes[2].grid(alpha=0.3)\n",
    "\n",
    "plt.suptitle(\"Mode Collapse Problemi\", fontsize=13)\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"fig_nb08_mode_collapse.png\", dpi=100, bbox_inches='tight')\n",
    "plt.show()\n"
   ]
  },
