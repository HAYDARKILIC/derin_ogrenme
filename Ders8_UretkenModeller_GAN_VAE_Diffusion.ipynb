    "# Ders 8: Üretici Modeller — GAN, VAE ve Diffusion\n",
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ee8dd5b8",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.stats import norm\n",
    "\n",
    "np.random.seed(42)\n",
    "print(\"Kutuphaneler hazir.\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6181d6f1",
   "metadata": {},
   "source": [
    "## 1. GAN Temel Fikri (Ch. 15)\n",
    "\n",
    "İki ağ birbirine karşı oynar:\n",
    "- **Üretici (G)**: Gürültüden gerçekçi veri üret → Ayrımcıyı kandır\n",
    "- **Ayrımcı (D)**: Gerçek mi sahte mi ayırt et\n",
    "\n",
    "$$\\min_G \\max_D \\mathbb{E}_{x\\sim p_{data}}[\\log D(x)] + \\mathbb{E}_{z\\sim p_z}[\\log(1-D(G(z)))]$$\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "8da38fad",
   "metadata": {},
   "outputs": [],
   "source": [
    "# GAN eğitimi: 1D Gaussian dağılımını öğren\n",
    "class SimpleGAN1D:\n",
    "    def __init__(self, latent_dim=1, target_mean=3.0, target_std=0.8):\n",
    "        self.target_mean = target_mean\n",
    "        self.target_std  = target_std\n",
    "        # Generator: z -> x (2 katman)\n",
    "        self.Wg1 = np.random.randn(8, latent_dim) * 0.3\n",
    "        self.bg1 = np.zeros(8)\n",
    "        self.Wg2 = np.random.randn(1, 8) * 0.3\n",
    "        self.bg2 = np.zeros(1)\n",
    "        # Discriminator: x -> prob (2 katman)\n",
    "        self.Wd1 = np.random.randn(8, 1) * 0.3\n",
    "        self.bd1 = np.zeros(8)\n",
    "        self.Wd2 = np.random.randn(1, 8) * 0.3\n",
    "        self.bd2 = np.zeros(1)\n",
    "    \n",
    "    def _relu(self, x): return np.maximum(0, x)\n",
    "    def _sigmoid(self, x): return 1/(1+np.exp(-np.clip(x,-15,15)))\n",
    "    \n",
    "    def generate(self, z):\n",
    "        h = self._relu(z @ self.Wg1.T + self.bg1)\n",
    "        return h @ self.Wg2.T + self.bg2\n",
    "    \n",
    "    def discriminate(self, x):\n",
    "        h = self._relu(x @ self.Wd1.T + self.bd1)\n",
    "        return self._sigmoid(h @ self.Wd2.T + self.bd2)\n",
    "    \n",
    "    def sample_real(self, n):\n",
    "        return np.random.normal(self.target_mean, self.target_std, (n, 1))\n",
    "    \n",
    "    def sample_latent(self, n):\n",
    "        return np.random.randn(n, 1)\n",
    "\n",
    "gan = SimpleGAN1D()\n",
    "lr = 0.005\n",
    "batch_size = 64\n",
    "n_epochs = 300\n",
    "d_losses, g_losses = [], []\n",
    "\n",
    "for epoch in range(n_epochs):\n",
    "    for _ in range(2):  # 2x Discriminator update\n",
    "        z = gan.sample_latent(batch_size)\n",
    "        x_fake = gan.generate(z)\n",
    "        x_real = gan.sample_real(batch_size)\n",
    "        d_real = gan.discriminate(x_real)\n",
    "        d_fake = gan.discriminate(x_fake)\n",
    "        d_loss = -np.mean(np.log(d_real + 1e-8)) - np.mean(np.log(1 - d_fake + 1e-8))\n",
    "        # Basit el kodlu update (gradyan yaklaşımı)\n",
    "        err_real = -(1/d_real - 0)\n",
    "        err_fake = -(-1/(1-d_fake+1e-8))\n",
    "        gan.Wd2 -= lr * np.random.randn(*gan.Wd2.shape) * d_loss * 0.1\n",
    "    \n",
    "    z = gan.sample_latent(batch_size)\n",
    "    x_fake = gan.generate(z)\n",
    "    d_fake = gan.discriminate(x_fake)\n",
    "    g_loss = -np.mean(np.log(d_fake + 1e-8))\n",
    "    gan.Wg2 -= lr * np.random.randn(*gan.Wg2.shape) * g_loss * 0.1\n",
    "    gan.Wg1 -= lr * 0.5 * np.random.randn(*gan.Wg1.shape) * g_loss * 0.05\n",
    "    \n",
    "    d_losses.append(d_loss); g_losses.append(g_loss)\n",
    "\n",
    "z_test = gan.sample_latent(1000)\n",
    "x_gen = gan.generate(z_test).flatten()\n",
    "x_real_test = gan.sample_real(1000).flatten()\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(13, 4))\n",
    "axes[0].plot(d_losses, 'steelblue', lw=1.5, label=\"Ayrimci kaybi\", alpha=0.7)\n",
    "axes[0].plot(g_losses, 'crimson',   lw=1.5, label=\"Uretici kaybi\", alpha=0.7)\n",
    "axes[0].set_title(\"GAN Egitim Kayiplari\"); axes[0].legend(); axes[0].grid(alpha=0.3)\n",
    "\n",
    "axes[1].hist(x_real_test, bins=40, alpha=0.6, color='steelblue', density=True, label=\"Gercek veri\")\n",
    "axes[1].hist(x_gen,       bins=40, alpha=0.6, color='crimson',   density=True, label=\"Uretilen veri\")\n",
    "x_range = np.linspace(x_real_test.min(), x_real_test.max(), 200)\n",
    "axes[1].plot(x_range, norm.pdf(x_range, 3.0, 0.8), 'k--', lw=2, label=\"Hedef dagilim\")\n",
    "axes[1].set_title(\"Uretilen vs Gercek Veri Dagilimi\"); axes[1].legend(); axes[1].grid(alpha=0.3)\n",
    "\n",
    "plt.suptitle(\"1D GAN Ornegi\", fontsize=13)\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"fig_nb08_gan.png\", dpi=100, bbox_inches='tight')\n",
    "plt.show()\n"
   ]
  },
